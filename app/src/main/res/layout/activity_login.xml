<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="@color/bg"
    android:padding="32dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sign in" android:textColor="@color/text_primary"
        android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="HMC CCTV" android:textColor="@color/text_secondary"
        android:textSize="13sp" android:layout_marginBottom="24dp" />

    <EditText android:id="@+id/etUsername" style="@style/MinimalInput"
        android:layout_width="260dp" android:hint="Username" android:inputType="text" />
    <EditText android:id="@+id/etPassword" style="@style/MinimalInput"
        android:layout_width="260dp" android:hint="Password" android:inputType="textPassword" />

    <Button android:id="@+id/btnLogin" android:layout_width="260dp" android:layout_height="52dp"
        android:layout_marginTop="8dp" android:text="Sign in" android:textColor="@color/bg"
        android:textStyle="bold" android:backgroundTint="@color/accent" android:background="@drawable/bg_input" />

    <TextView android:id="@+id/tvLoginError" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:textColor="@color/danger" android:textSize="13sp"
        android:visibility="invisible" android:text="Incorrect username or password" />
</LinearLayout>
